{
  "name": "forge-tools",
  "description": "A Forgejo-first forge client for agent sessions: API access, a PR queue with draft batching, a gate watcher, handoff pages, worktree lifecycle and target-repo bootstrap.",
  "commands": [
    {"name": "hub-api", "source": "scripts/hub-api.sh",
     "beside": ["scripts/ft-config.sh", "scripts/forge.sh", "scripts/gate-watch.py", "scripts/agent_comms.py", "scripts/ft_config.py",
                "scripts/templates/forgejo/python.yml", "scripts/templates/forgejo/rust.yml", "scripts/templates/test.yml"]},
    {"name": "pr-queue", "source": "scripts/pr-queue.sh",
     "beside": ["scripts/ft-config.sh", "scripts/close_ref.py", "scripts/agent_comms.py", "scripts/batch_blame.py", "scripts/forge.sh",
                "scripts/hub-api.sh", "scripts/gate-watch.py", "scripts/live-drains.sh", "scripts/prune-landed-branches-forgejo.sh",
                "scripts/bash_cmd_parse.py"]},
    {"name": "forge", "source": "scripts/forge.sh", "beside": ["scripts/ft-config.sh", "scripts/hub-api.sh"]},
    {"name": "gate-watch", "source": "scripts/gate-watch.py",
     "beside": ["scripts/ft_config.py", "scripts/agent_comms.py", "scripts/hub-api.sh"]},
    {"name": "forge-doctor", "source": "scripts/doctor.sh", "beside": ["scripts/ft-config.sh", "scripts/hub-api.sh"]},
    {"name": "handoff", "source": "scripts/handoff.sh",
     "beside": ["scripts/ft-config.sh", "scripts/agent_comms.py", "scripts/skill_trigger_exceptions.txt", "scripts/hub-api.sh"]},
    {"name": "worktree-create", "source": "scripts/worktree-create.sh", "beside": ["scripts/ft-config.sh"]},
    {"name": "worktree-reap", "source": "scripts/worktree-reap.sh",
     "beside": ["scripts/ft-config.sh", "scripts/agent_comms.py", "scripts/prune-landed-branches-forgejo.sh"]},
    {"name": "resource-lock", "source": "scripts/resource-lock.sh", "beside": ["scripts/running-suites"]},
    {"name": "running-suites", "source": "scripts/running-suites"},
    {"name": "bootstrap-target-repo", "source": "scripts/bootstrap-target-repo.sh",
     "beside": ["scripts/ft-config.sh", "scripts/hub-api.sh", "scripts/templates/fallow.yml", "scripts/templates/fallowrc.json",
                "scripts/templates/test.yml"]},
    {"name": "prune-landed-branches-forgejo", "source": "scripts/prune-landed-branches-forgejo.sh",
     "beside": ["scripts/ft-config.sh", "scripts/bash_cmd_parse.py", "scripts/hub-api.sh"]},
    {"name": "live-drains", "source": "scripts/live-drains.sh", "beside": ["scripts/ft-config.sh"]}
  ],
  "requires": {"python": ">=3.9", "commands": ["git", "curl", "flock", "setsid", "bash", "session-attest", "session-notify"]},
  "state_dir": {"path": "${XDG_STATE_HOME:-$HOME/.local/state}/forge-tools"},
  "runtime_paths": [],
  "privileged": false
}
